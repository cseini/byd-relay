<?xml version="1.0" encoding="utf-8"?>
<!-- ★847 통신 복구 팝업 — 메인의 '통신 복구' 버튼 하나로만 연다. 자동 호출 없음(NETFIX 롤백 교훈). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="통신 복구" android:textSize="24sp" android:textStyle="bold" android:textColor="#E6EAF0" />
            <Button android:id="@+id/netCloseButton" android:layout_width="56dp" android:layout_height="56dp" android:text="✕" android:textSize="20sp" android:textColor="#B8C0CC" android:background="@drawable/bg_btn" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_warn_box" android:padding="16dp" android:layout_marginTop="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="셀룰러가 죽었을 때만 쓰세요" android:textSize="18sp" android:textStyle="bold" android:textColor="#F2994A" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp"
                android:text="안테나는 뜨는데 인터넷이 안 될 때만 누르세요. 잘 되고 있을 때 누르면 오히려 통신이 끊길 수 있습니다. 그 외에는 절대 손대지 마세요."
                android:textSize="15sp" android:textColor="#E6C8B4" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="위에서부터 하나씩 누르고, 누를 때마다 인터넷이 되는지 확인하세요. 결과는 개발자에게도 전달됩니다."
            android:textSize="14sp" android:textColor="#8A93A2" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/netStateButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp" android:layout_marginEnd="5dp"
                android:text="1\n통신 상태 보기" android:textSize="14sp" android:textColor="#E6EAF0" android:textAllCaps="false" android:background="@drawable/bg_btn" />
            <Button android:id="@+id/netAirOffButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
                android:text="2\n비행기 모드 끄기" android:textSize="14sp" android:textColor="#E6EAF0" android:textAllCaps="false" android:background="@drawable/bg_btn" />
            <Button android:id="@+id/netDataOnButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
                android:text="3\n모바일 데이터 켜기" android:textSize="14sp" android:textColor="#E6EAF0" android:textAllCaps="false" android:background="@drawable/bg_btn" />
            <Button android:id="@+id/netApnButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
                android:text="4\nAPN 기본값 복원" android:textSize="14sp" android:textColor="#E6EAF0" android:textAllCaps="false" android:background="@drawable/bg_btn" />
            <Button android:id="@+id/netReconnectButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp" android:layout_marginStart="5dp"
                android:text="5\n재연결 1회" android:textSize="14sp" android:textColor="#E6EAF0" android:textAllCaps="false" android:background="@drawable/bg_btn" />
        </LinearLayout>

        <TextView
            android:id="@+id/netResultView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:background="@drawable/bg_panel"
            android:text="결과가 여기에 표시됩니다."
            android:textSize="13sp"
            android:textColor="#B8C0CC"
            android:typeface="monospace"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
