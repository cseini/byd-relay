<?xml version="1.0" encoding="utf-8"?>
<!-- ★847 뒷좌석 착좌 팝업 — 메인 '시험 기능'의 체크를 켜면 뜨고, 닫으면 체크도 꺼진다. 떠 있는 동안 1초마다 갱신(MainActivity.refreshSeat). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="뒷좌석 착좌 (시험)" android:textSize="24sp" android:textStyle="bold" android:textColor="#E6EAF0" />
            <Button android:id="@+id/seatCloseButton" android:layout_width="56dp" android:layout_height="56dp" android:text="✕" android:textSize="20sp" android:textColor="#B8C0CC" android:background="@drawable/bg_btn" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
            <TextView android:id="@+id/seatL" android:layout_width="0dp" android:layout_weight="1" android:layout_height="120dp" android:layout_marginEnd="6dp" android:gravity="center" android:textSize="17sp" android:textColor="#0E1116" android:text="왼쪽" />
            <TextView android:id="@+id/seatC" android:layout_width="0dp" android:layout_weight="1" android:layout_height="120dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center" android:textSize="17sp" android:textColor="#0E1116" android:text="가운데" />
            <TextView android:id="@+id/seatR" android:layout_width="0dp" android:layout_weight="1" android:layout_height="120dp" android:layout_marginStart="6dp" android:gravity="center" android:textSize="17sp" android:textColor="#0E1116" android:text="오른쪽" />
        </LinearLayout>

        <TextView android:id="@+id/seatReasonView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="14dp"
            android:background="@drawable/bg_panel" android:text="—" android:textSize="14sp" android:textColor="#B8C0CC" android:lineSpacingExtra="3dp" android:textIsSelectable="true" />
        <TextView android:id="@+id/seatEventsView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="14dp"
            android:background="@drawable/bg_panel" android:text="최근 이벤트 없음" android:textSize="13sp" android:textColor="#8A93A2" android:typeface="monospace" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="1초마다 갱신 · 창을 닫으면 메인의 체크도 같이 꺼집니다" android:textSize="13sp" android:textColor="#8A93A2" />
    </LinearLayout>
</ScrollView>
