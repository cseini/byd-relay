    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />

    <application
        android:name=".SnifferApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- ★710/713 최근 앱 목록에서 숨김(운영자 10-03 "업데이트 뒤 활성앱에 릴레이가 두 개") — 업데이트·감시 부활의 am start가 새 카드를 만들어 옛 카드와 두 장이 되던 것. 목록에서 쓸어 꺼지는 일도 줄인다 -->
        <activity
            android:name=".SentryViewerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ★v209 주차 중 화면 깨우기 — 투명 Activity 윈도우 플래그(FLAG_TURN_SCREEN_ON) -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ★574 시동 ON 업데이트 안내 — 자동 업데이트가 조용히 실패하는 차(구버전 정체)를 위해 화면에 한 번 띄운다.
             투명 테마 = 현재 화면 위에 다이얼로그만 얹힘. 주행 시작하면 onStop에서 스스로 닫는다. -->
        <activity
            android:name=".UpdatePromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ★분할 고스트(2026-09-11): 셸 am start(windowingMode 3)로 도킹 스택 생성용. exported 필수(셸 실행), resizeable 필수(분할 진입). -->
        <activity
            android:name=".SplitGhostActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.cseini.bydsniffer.splitghost"
            android:theme="@android:style/Theme.NoTitleBar" />

        <service
            android:name=".SnifferService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 상시생존 강화 — 접근성 서비스. ★v48: diplus KDService 방식 = 별도 프로세스(:relay)+포그라운드+접근성 3중.
             메인(SnifferService) 프로세스가 원격끔 킬로 죽어도 이 프로세스는 분리돼 살아남아 메인을 되살린다. -->
        <service
            android:name=".KeepAliveAccessibilityService"
            android:exported="true"
            android:process=":relay"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/keepalive_accessibility" />
        </service>

        <!-- ★v214 :relay 프로세스 warm 유지 앵커 — a11y 얼어붙음(딥슬립/업데이트 후 미바인드) 방지 -->
        <service
            android:name=".RelayAnchorService"
            android:exported="false"
            android:process=":relay"
            android:foregroundServiceType="specialUse" />

        <!-- 헤드유닛 재부팅(시동 ON) 후 릴레이 서비스 자동 시작 — 일렉트로 동일 priority 9900 + LOCKED_BOOT -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="9900">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.byd.action.ACC_ON" />
                <action android:name="com.byd.action.IGN_ON" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>

        <!-- 상시생존 이중화 — JobScheduler 백스톱(알람과 별개로 서비스 사망 시 재기동, 재부팅 후에도 persist) -->
        <service
            android:name=".SnifferJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.cseini.bydsniffer.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
        <!-- ★650 android.car(Car/CarPropertyManager) 클래스 로드용 — D5에만 있음, 없는 차(D3)는 required=false라 설치 영향 없음. -->
        <uses-library android:name="android.car" android:required="false" />
    </application>

</manifest>
